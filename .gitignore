node_modules/
.wrangler/
.dev.vars
mise.local.toml
# Claude Code の project スコープの MCP 設定（デプロイ先の URL が入るので、各自の手元にだけ置く）
.mcp.json
# Codex の手元の設定（MCP の接続先など、デプロイ先の URL が入る）
.codex/
dist/
*.log
.DS_Store
.dev.vars.rovo-e2e-backup
.claude/*
!.claude/settings.json

# Terraform（infra/）。state には Logpush の資格情報が平文で残るので、必ず除外する。
# .terraform.lock.hcl は再現性のためコミットする。backend.tf と *.tfvars は下流（private）がコミットするので除外しない。
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/crash.log

# Playwright（apps/dashboard の E2E）の成果物
test-results/
playwright-report/

# Claude Code の mod（plugins/rovo）の型。エンジンが自動生成する
plugins/*/.claude-plugin/types/

# 環境ごとの値・秘密（秘密が入るファイルだけを除外する。rovo.config.json と deploy/ は秘密を含まず、下流がコミットするので除外しない）
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local.toml
*.pem
*.key

# テスト・ビルドの成果物
coverage/
.nyc_output/
.vitest/
*.tsbuildinfo
.turbo/
.mf/
