{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovo-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // Gateway からは DO バインディングで呼ぶので workers.dev では公開しない（ルートも持たない）
  "workers_dev": false,
  "containers": [
    {
      "class_name": "SandboxDO",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX_DO", "class_name": "SandboxDO" },
      { "name": "AGENT_DO", "class_name": "AgentDO" }
    ]
  },
  "exports": {
    "SandboxDO": { "type": "durable-object", "storage": "sqlite" },
    "AgentDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "services": [
    // apps/web（Web Research Service）。子の web_search / web_fetch が使う。caller は props で "child" に固定する。
    {
      "binding": "WEB",
      "service": "rovo-web",
      "entrypoint": "WebResearch",
      "props": { "caller": "child" }
    }
  ],
  // Workers AI バインディング。createAI が AI Gateway（BYOK）経由で Claude を呼ぶ。
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    // AI Gateway の ID（空なら Gateway を通さない）。デプロイ時に実際の ID へ変える。
    "AI_GATEWAY_ID": "",
    // 子エージェントのモデル。単価表（src/agent/pricing.ts）にあるものだけ使える。
    "AGENT_MODEL": "anthropic/claude-sonnet-5-5",
    // ENVIRONMENT=test のときだけ有効。許可した外向き通信の転送先（偽サーバー）。空なら実ネットワークへ出る。
    "TEST_UPSTREAM": "",
    // 子の web_search / web_fetch / web_browse の回数の上限（タスクごと）
    "WEB_SEARCH_LIMIT_PER_TASK": "50",
    "WEB_FETCH_LIMIT_PER_TASK": "100",
    "WEB_BROWSE_LIMIT_PER_TASK": "20",
    // web_browse を子のツールとして出すか（"true" のときだけ。既定は無効で、ツールもシステムプロンプトの記述も出さない）。
    // 有効にする前に、phase5.md の「有効化前のゲート」を満たすこと。apps/web と apps/gateway の同名の var も合わせる。
    "WEB_BROWSE_ENABLED": "false"
  }
}
