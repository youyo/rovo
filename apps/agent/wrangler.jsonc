{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovo-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // Gateway からは DO バインディングで呼ぶので workers.dev では公開しない（ルートも持たない）
  "workers_dev": false,
  "containers": [
    {
      "class_name": "SandboxDO",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX_DO", "class_name": "SandboxDO" },
      { "name": "AGENT_DO", "class_name": "AgentDO" },
      // 依存関係のキャッシュ（D14）の状態を鍵ごとに持つ。コンテナは持たない（作成は SandboxDO の別インスタンス）
      { "name": "DEPS_CACHE_DO", "class_name": "DepsCacheDO" }
    ]
  },
  "exports": {
    "SandboxDO": { "type": "durable-object", "storage": "sqlite" },
    "AgentDO": { "type": "durable-object", "storage": "sqlite" },
    "DepsCacheDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "services": [
    // apps/web（Web Research Service）。子の web_search / web_fetch が使う。caller は props で "child" に固定する。
    {
      "binding": "WEB",
      "service": "rovo-web",
      "entrypoint": "WebResearch",
      "props": { "caller": "child" }
    }
  ],
  // Workers AI バインディング。createAI が AI Gateway（BYOK）経由で Claude を呼ぶ。
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    // AI Gateway の ID（空なら Gateway を通さない）。デプロイ時に実際の ID へ変える。
    "AI_GATEWAY_ID": "",
    // 子エージェントの既定のモデル。許可リスト（packages/models。単価は pi-ai のカタログ由来）にあるものだけ使える。
    "AGENT_MODEL": "anthropic/claude-sonnet-5-5",
    // タスクごとに選べるモデル（カンマ区切り。task_start の model と consult の model に使える）。
    // 空なら AGENT_MODEL だけ（fail-closed）。許可リストに無い id は無視する。gateway の同名の var と同じ値にする。
    // 例: "anthropic/claude-haiku-5-5,anthropic/claude-sonnet-5-5,anthropic/claude-opus-5-5,openai/gpt-6-sol,workers-ai/@cf/openai/gpt-oss-120b"
    // Workers AI のモデル（workers-ai/@cf/...。キー不要・無料プランでも使えるものだけ。D10b）も同じ var に書く。gateway が決めたモデルを agent がここで再検証する。
    "AGENT_MODELS": "",
    // モデルごとの思考レベルの上書き（`<モデルの id>=<レベル>` のカンマ区切り。レベルは off / minimal / low / medium / high / xhigh / max）。
    // 空なら packages/models の EFFORTS（haiku=low, sonnet=high, opus=medium, fable=low, luna=low, sol=medium, astra=low、Workers AI は gpt-oss / qwen / nemotron / glm-4.7-flash=low、gemma=high）。
    // モデルが受け付けない値・不正な書式は無視して初期値にする（起動はエラーにしない）。思考のトークンは出力として課金される。gateway の同名の var と同じ値にする。
    // 例: "anthropic/claude-sonnet-5-5=medium,anthropic/claude-haiku-5-5=off"
    "MODEL_EFFORTS": "",
    // Sandbox コンテナの大きさ（lite / standard-1 / standard-2 / standard-3 / standard-4）。scheduling_policy が durable_object のとき、
    // wrangler の instance_type は効かず、SandboxDO が start() の instance に渡す。既定は standard-2（1 vCPU、6 GiB、12 GB）。
    // 不正な値は standard-2 に戻す（警告のログだけ）。単価（gateway の SANDBOX_USD_PER_HOUR）は大きさに合わせる。docs/deploy.md の 5。
    "SANDBOX_INSTANCE": "standard-2",
    // Sandbox を自動で上げる上限の大きさ（standard-1〜standard-4）。Sandbox は小さく始まり、子のコマンド（と検証コマンド）の前に
    // Clef（Workers AI の決定モデル。既存の ai バインディングと AI_GATEWAY_ID を使う）が「今の大きさで足りるか」を判断し、足りなければ
    // 今のコンテナのスナップショットを取り、同じスナップショットから大きい大きさで起動し直す（2 → 3 → 4 と何回でも。上げるだけで下げない）。
    // 空・"off" で無効（Clef を呼ばず、昇格しない）。task_start で sandbox_instance を明示したタスクは固定で、Clef も呼ばない。
    // Clef の判断やスナップショットが失敗しても、タスクは失敗しない（今の大きさのまま続ける）。既定は standard-4。gateway の同名の var と同じ値にする。docs/deploy.md の 11。
    "SANDBOX_MAX_INSTANCE": "standard-4",
    // Clef の判断の閾値（任意。空は既定）。`heavy=0.5,four=0.4,heavy_band=0.2-0.7,four_band=0.2-0.5` の形で、書いたキーだけ上書きする。実験で調整した既定値を env で変えられるようにしてある。docs/deploy.md の 11。
    "SANDBOX_CLEF_THRESHOLDS": "",
    // 依存関係のキャッシュ（D14。Containers のスナップショット）を使うか。"false" / "0" / "off" で無効にする（既定は有効）。
    // スナップショットは public beta で、使えない・失敗してもタスクは今までどおり動く（fail-soft）。docs/deploy.md の 5。
    "DEPS_CACHE_ENABLED": "true",
    // ENVIRONMENT=test のときだけ有効。許可した外向き通信の転送先（偽サーバー）。空なら実ネットワークへ出る。
    "TEST_UPSTREAM": "",
    // 子の web_search / web_fetch / web_browse の回数の上限（タスクごと）
    "WEB_SEARCH_LIMIT_PER_TASK": "50",
    "WEB_FETCH_LIMIT_PER_TASK": "100",
    "WEB_BROWSE_LIMIT_PER_TASK": "20",
    // web_browse を子のツールとして出すか（"true" のときだけ。既定は無効で、ツールもシステムプロンプトの記述も出さない）。
    // 有効にする前に、docs/specs/acceptance.md の「web_browse（有効化前のゲート）」を満たすこと。apps/web と apps/gateway の同名の var も合わせる。
    "WEB_BROWSE_ENABLED": "false"
  }
}
