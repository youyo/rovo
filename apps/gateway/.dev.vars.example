# ローカル開発用。`cp .dev.vars.example .dev.vars` して値を埋める（.dev.vars は gitignore 済み）。
# 本番の secret は `wrangler secret put <NAME>` で設定する（このファイルには書かない）。

# GitHub App（ユーザー認可を有効にしたもの）の Client ID / Client secret
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App の App ID と秘密鍵（PKCS#8 の PEM。1 行にするなら改行を \n にする）。
# GitHub がくれる PKCS#1 は変換する: openssl pkcs8 -topk8 -nocrypt -in app.private-key.pem -out app.pkcs8.pem
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Draft PR を作れないリポジトリでの扱い: fail（既定。不正な値も fail）/ ready
# DRAFT_PR_FALLBACK=fail
# true のときだけ費用を PR 本文に載せる
# PR_SHOW_COST=false

# タスク 1 件に予約する予算（USD。既定 10。0 以下・不正な値は 10）。子エージェントの budgetUsd にも同じ値を渡す。
# 月額の枠（MONTHLY_BUDGET_USD）を 10 未満にするときは、これも下げる
# TASK_BUDGET_USD=10

# consult（セカンドオピニオン）1 回に予約する予算（USD。既定 0.5。0 以下・不正な値は 0.5）
# CONSULT_BUDGET_USD=0.5

# 既定のモデルと、task_start / consult の model に選べるモデル（カンマ区切り。空なら AGENT_MODEL だけ）。
# agent の同名の var と同じ値にする。
# AGENT_MODEL=anthropic/claude-sonnet-5-5
# AGENT_MODELS=anthropic/claude-haiku-5-5,anthropic/claude-sonnet-5-5

# ログインとツール呼び出しを許可する範囲。次の 2 つのうち少なくとも 1 つを設定する（どちらかを満たせば許可）。
# 1. org と team（slug）。対で設定する。片方だけだと設定の誤りとしてログインできない
ALLOWED_ORG=
ALLOWED_TEAM=
# 2. GitHub の数値の user ID（カンマ区切り。個人で使うときはこちら）。自分の ID: gh api user --jq .id
#    不正な要素（数字以外・0・重複・空要素）が 1 つでもあれば全体が不正になる。例: ALLOWED_USER_IDS=12345,67890
ALLOWED_USER_IDS=

# GitHub トークンの暗号化鍵（base64 の 32 バイト）: openssl rand -base64 32
TOKEN_ENC_KEY=

# ローカル開発では公開 URL を localhost にする。GitHub App のコールバック URL は
# http://localhost:8787/callback を追加登録する。
PUBLIC_BASE_URL=http://localhost:8787
