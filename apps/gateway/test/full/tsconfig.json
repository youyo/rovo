{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../vitest.e2e-full.config.ts",
    "../../../agent/test/support/wrangler.ts",
    "../../../agent/test/support/fake-upstream.ts"
  ]
}
