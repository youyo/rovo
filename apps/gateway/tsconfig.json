{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test/unit",
    "test/support",
    "test/contract",
    "worker-configuration.d.ts",
    "vitest.config.ts"
  ]
}
