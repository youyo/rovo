{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovo-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // ダッシュボード（apps/dashboard の SPA。/dashboard）の静的ファイル。dist は mise の build:dashboard が作る（無いと wrangler dev / deploy が失敗する）。
  // run_worker_first: true は必須: Worker が /dashboard/* だけを env.ASSETS に渡す。assets の自動配信に任せると、/mcp などを飲み込みうる。
  "assets": { "directory": "../dashboard/dist", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "durable_objects": {
    "bindings": [
      { "name": "TASK_DO", "class_name": "TaskDO" },
      { "name": "USER_DO", "class_name": "UserDO" },
      // ダッシュボードの索引（シングルトン。TaskDO が outbox で配送する。docs/specs/dashboard.md D10）
      { "name": "DIRECTORY_DO", "class_name": "DirectoryDO" },
      // apps/agent の AgentDO（別 Worker）。ローカルでは両方を同時に wrangler dev で起動すること（片方だけだと本番の DO を叩く）。
      { "name": "AGENT_DO", "class_name": "AgentDO", "script_name": "rovo-agent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskDO", "UserDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectoryDO"] }
  ],
  "services": [
    // apps/web（Web Research Service）の WebResearch エントリポイント。呼び出し元の種別は props で固定する
    // （web は RPC の引数ではなく ctx.props から caller を取る）。デプロイは web → agent → gateway の順。
    {
      "binding": "WEB",
      "service": "rovo-web",
      "entrypoint": "WebResearch",
      "props": { "caller": "parent" }
    }
  ],
  "vars": {
    // "test" のときだけ GitHub の接続先（GITHUB_OAUTH_BASE / GITHUB_API_BASE）の上書きを許す。本番は必ず "production"。
    "ENVIRONMENT": "production",
    // 公開 URL（OAuth の issuer / resource の元になる）。デプロイ時に実 URL へ置き換える。
    "PUBLIC_BASE_URL": "https://rovo-gateway.example.workers.dev",
    // GitHub App のクライアント ID（秘密ではない）。デプロイ時に実値へ置き換える。空のままだとログインは失敗する（fail closed）。
    "GITHUB_APP_CLIENT_ID": "",
    // ログインとツール呼び出しを許可する範囲。次の 2 つのルールのうち少なくとも 1 つを完全に設定する（どちらかを満たせば許可）。
    // - org/team: ALLOWED_ORG と ALLOWED_TEAM は対。片方だけならログインは失敗する（fail closed）。
    // - user ID: ALLOWED_USER_IDS はカンマ区切りの GitHub の数値 ID（正の整数。不正な要素が 1 つでもあれば全体が不正）。
    //   login は改名できるので使わない。自分の ID は `gh api user --jq .id`。
    "ALLOWED_ORG": "",
    "ALLOWED_TEAM": "",
    "ALLOWED_USER_IDS": "",
    // 親（MCP の web_search / web_fetch / web_browse）の回数の上限。ユーザーごとに UTC の1日あたり
    "WEB_SEARCH_DAILY_LIMIT": "200",
    "WEB_FETCH_DAILY_LIMIT": "500",
    "WEB_BROWSE_DAILY_LIMIT": "50",
    // web_browse を MCP のツールとして公開するか（"true" のときだけ。既定は無効で、tools/list にも出ない）。
    // 有効にする前に、docs/specs/acceptance.md の「web_browse（有効化前のゲート）」を満たすこと。apps/web と apps/agent の同名の var も合わせる。
    "WEB_BROWSE_ENABLED": "false",
    // task_start で sandbox_instance を省略したときの Sandbox の大きさ（sandbox_instances_list の default）。agent の同名の var と同じ値にする（deploy:config は rovo.config.json の sandbox.instance から両方を決める）
    "SANDBOX_INSTANCE": "standard-2",
    // 重いコマンド（テスト・ビルドなど）の初回に Sandbox が自動で昇格する先の大きさ（sandbox_instances_list の promotion_target）。agent の同名の var と同じ値にする
    // （deploy:config は rovo.config.json の sandbox.heavyInstance から両方を決める）。空・"off" は昇格しない。
    "SANDBOX_HEAVY_INSTANCE": "standard-3",
    // 要約（task_summary / summary.json）の「推定」金額の単価（USD）。Cloudflare の公式料金表（取得日 2026-10-19）の既定値で、
    // 料金改定や agent の SANDBOX_INSTANCE の変更に合わせて下流が上書きする（deploy:config は sandbox.instance から計算する）。タスクの予算（$10）には含めない。出典は docs/specs/phase6.md。
    // Sandbox: Containers の standard-2（既定の SANDBOX_INSTANCE。1 vCPU・6 GiB・12 GB）を CPU 100% 稼働で 1 時間（月の無料枠は差し引かない上限側の推定）。
    // 未設定・不正なら packages/models が決める standard-2 の値。agent の SANDBOX_INSTANCE を変えたら、packages/models の sandboxUsdPerHour と同じ値にする
    "SANDBOX_USD_PER_HOUR": "0.1291",
    // Web（子が使った分）: 1,000 回あたり。search は Web Search API の ceramic、browse は Browser Run 30 秒/回の上限側の推定
    "WEB_USD_PER_1K_SEARCH": "0.25",
    "WEB_USD_PER_1K_FETCH": "0",
    "WEB_USD_PER_1K_BROWSE": "0.75",
    // タスク 1 件に予約する予算（USD）。月額の枠（MONTHLY_BUDGET_USD、既定 100）からこの額を予約し、子エージェントの上限（budgetUsd）にも同じ値を渡す。
    // 不正な値・0 以下は 10。月額の枠を 10 未満にするときは、これも下げる（枠より大きいとタスクを始められない）。
    "TASK_BUDGET_USD": "10",
    // consult（セカンドオピニオン）1 回に月額の枠から予約する額（USD。実費で精算する）。不正な値・0 以下は 0.5。
    // max_output_tokens もこの額に収まるよう絞られる。
    "CONSULT_BUDGET_USD": "0.5",
    // 利用者ごとに同時に実行できるタスクの上限（1 以上の整数。不正な値・未設定は 2）。月額の枠とは別に、両方を満たすときだけ task_start が通る。
    // 上限に達すると concurrency_limit。値は budget_status の concurrency_limit で見える。
    "MAX_CONCURRENT_TASKS": "2",
    // AI Gateway の ID（agent の同名の var と同じ値にする）と Cloudflare の account id。secret の CLOUDFLARE_API_TOKEN（Account / AI Gateway / Read だけ）と
    // 合わせて、Gateway に BYOK 登録されたプロバイダーキー（List provider keys）を読み、キーが無いプロバイダーのモデルを選べなくする（D10b）。
    // どれかが空なら判定せず、従来どおり AGENT_MODELS だけで決める。account id は公開しない値なので、デプロイ時に実値へ置き換える（deploy.example 参照）。
    "AI_GATEWAY_ID": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    // 既定のモデル（task_start の model を省略したとき）。agent の同名の var と同じ値にする。
    "AGENT_MODEL": "anthropic/claude-sonnet-5-5",
    // 選べるモデル（カンマ区切り。task_start の model と consult の model。models_list に出る）。
    // 空なら AGENT_MODEL だけ（fail-closed）。許可リスト（packages/models）に無い id は無視する。agent の同名の var と同じ値にする。
    // Workers AI のモデル（"workers-ai/@cf/openai/gpt-oss-120b" など。キー不要）を入れておくと、Anthropic / OpenAI のキーが無いときの既定になる。
    "AGENT_MODELS": "",
    // モデルごとの思考レベルの上書き（`<モデルの id>=<レベル>` のカンマ区切り。models_list の effort と task_status / task_result に出る）。
    // 空なら packages/models の EFFORTS。不正な項目は無視して初期値にする。agent の同名の var と同じ値にする。
    "MODEL_EFFORTS": ""
  }
}
