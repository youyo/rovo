{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/worker-configuration.d.ts", "!**/pnpm-lock.yaml", "!docs"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": { "enabled": true },
  "overrides": [
    {
      "includes": ["plugins/rovo/**"],
      "linter": {
        "rules": {
          "style": { "useTemplate": "off" },
          "complexity": { "useOptionalChain": "off" },
          "correctness": { "noUnusedFunctionParameters": "off" },
          "suspicious": { "noControlCharactersInRegex": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
