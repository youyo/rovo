{
  // gateway の設定の雛形。`mise run deploy:config` が <...> を rovo.config.json と terraform の出力で埋めて、deploy/gateway.wrangler.jsonc を生成する。
  // 手で埋めない（<...> が 1 つでも残ると deploy:* は失敗する）。値の意味は docs/deploy.md の 5。
  // `main` などのパスは、この設定ファイルからの相対パス（ROVO_DEPLOY_DIR=deploy なら ../apps/... で upstream を指す）。
  // 内容は apps/gateway/wrangler.jsonc に揃えてある。upstream が変わったらこの雛形も合わせる。
  "name": "<GATEWAY_WORKER_NAME>",
  "main": "../apps/gateway/src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  // ダッシュボード（SPA。/dashboard）の静的ファイル。mise の build:dashboard / scripts/deploy.sh が apps/dashboard/dist を作る。
  // run_worker_first: true は必須（Worker が /dashboard/* だけを assets に渡し、/mcp・/authorize などを飲み込ませない）。
  "assets": {
    "directory": "../apps/dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 監査ログを Logpush（infra/ の Terraform が作るジョブ）に流す。ScriptName で絞る。名前は rovo.config.json の workerNames で決め、Terraform の worker_names にも同じ値が渡る。
  "logpush": true,
  // Workers Logs の head sampling を 100% にする（docs/deploy.md の 10）。
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // terraform output kv_namespace_id の値
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<KV_NAMESPACE_ID>" }],
  // アーカイブ（docs/deploy.md の 9）。gateway にだけ置く。terraform output archive_bucket_name の値
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "<ARCHIVE_BUCKET_NAME>" }],
  "durable_objects": {
    "bindings": [
      { "name": "TASK_DO", "class_name": "TaskDO" },
      { "name": "USER_DO", "class_name": "UserDO" },
      // ダッシュボードの索引（シングルトン。TaskDO が outbox で配送する。docs/specs/dashboard.md D10）
      { "name": "DIRECTORY_DO", "class_name": "DirectoryDO" },
      { "name": "AGENT_DO", "class_name": "AgentDO", "script_name": "<AGENT_WORKER_NAME>" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskDO", "UserDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectoryDO"] }
  ],
  "services": [
    {
      "binding": "WEB",
      "service": "<WEB_WORKER_NAME>",
      "entrypoint": "WebResearch",
      "props": { "caller": "parent" }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // 公開 URL（OAuth の issuer / resource の元。GitHub のコールバックは <PUBLIC_BASE_URL>/callback）
    "PUBLIC_BASE_URL": "<PUBLIC_BASE_URL>",
    "GITHUB_APP_ID": "<GITHUB_APP_ID>",
    "GITHUB_APP_CLIENT_ID": "<GITHUB_APP_CLIENT_ID>",
    // 認可: org/team（対で設定）か ALLOWED_USER_IDS（カンマ区切りの GitHub の数値 ID。gh api user --jq .id）の少なくとも 1 つ。
    // 個人で使うなら ALLOWED_USER_IDS だけを設定し、ALLOWED_ORG / ALLOWED_TEAM は空にする。
    "ALLOWED_ORG": "<ALLOWED_ORG>",
    "ALLOWED_TEAM": "<ALLOWED_TEAM>",
    "ALLOWED_USER_IDS": "<ALLOWED_USER_IDS>",
    // 予算（USD。rovo.config.json の budget）。月額の枠から 1 タスクにつき TASK_BUDGET_USD を予約する。月額を 10 未満にするときは TASK_BUDGET_USD も下げる。
    "MONTHLY_BUDGET_USD": "<MONTHLY_BUDGET_USD>",
    "TASK_BUDGET_USD": "<TASK_BUDGET_USD>",
    // consult（セカンドオピニオン）1 回に月額の枠から予約する額（USD。実費で精算する。既定 0.5）。max_output_tokens もこの額に収まるよう絞られる。
    "CONSULT_BUDGET_USD": "<CONSULT_BUDGET_USD>",
    // 利用者ごとに同時に実行できるタスクの上限（rovo.config.json の concurrency.maxTasks。1 以上の整数。既定 2）。月額の枠とは別で、両方を満たすときだけ task_start が通る。
    // 上限に達すると concurrency_limit。値は budget_status の concurrency_limit で見える。
    "MAX_CONCURRENT_TASKS": "<MAX_CONCURRENT_TASKS>",
    // 使えるモデル（rovo.config.json の models）。AGENT_MODEL は既定（task_start の model を省略したとき）、AGENT_MODELS はカンマ区切りの選べるモデル
    // （task_start の model と consult の model。models_list に出る）。空なら AGENT_MODEL だけ。agent の同名の var と同じ値にする。
    "AGENT_MODEL": "<AGENT_MODEL>",
    // Workers AI のモデル（workers-ai/@cf/...。キー不要。無料プランでも使えるものだけ）を入れておくと、Anthropic / OpenAI のキーが無いときの代わりになる。
    "AGENT_MODELS": "<AGENT_MODELS>",
    // AI Gateway に BYOK 登録されたプロバイダーキーを読んで、キーが無いプロバイダーのモデルを選べなくする（D10b）。
    // AI_GATEWAY_ID は agent と同じ値（terraform output ai_gateway_id）、CLOUDFLARE_ACCOUNT_ID は Cloudflare の account id（公開しない値）。
    // secret の CLOUDFLARE_API_TOKEN（権限は Account / AI Gateway / Read だけ）と合わせて設定する。どれかが空なら判定せず AGENT_MODELS だけで決める。
    "AI_GATEWAY_ID": "<AI_GATEWAY_ID>",
    "CLOUDFLARE_ACCOUNT_ID": "<ACCOUNT_ID>",
    // モデルごとの思考レベルの上書き（`<モデルの id>=<レベル>` のカンマ区切り。models_list の effort と task_status / task_result に出る）。空なら upstream の既定。agent の同名の var と同じ値にする。
    "MODEL_EFFORTS": "<MODEL_EFFORTS>",
    "WEB_SEARCH_DAILY_LIMIT": "200",
    "WEB_FETCH_DAILY_LIMIT": "500",
    "WEB_BROWSE_DAILY_LIMIT": "50",
    // web_browse を MCP のツールとして公開するか。雛形の既定は無効。有効にする手順は docs/deploy.md の 12。web / agent の同名の var も合わせる。
    "WEB_BROWSE_ENABLED": "<WEB_BROWSE_ENABLED>",
    // task_start で sandbox_instance を省略したときの Sandbox の大きさ（sandbox_instances_list の default）。rovo.config.json の sandbox.instance から入り、agent の同名の var と同じ値になる。
    "SANDBOX_INSTANCE": "<SANDBOX_INSTANCE>",
    // Clef が Sandbox を自動で上げる上限の大きさ（sandbox_instances_list の auto_scale_max。空は昇格しない）。rovo.config.json の sandbox.maxInstance から入り、agent の同名の var と同じ値になる。
    "SANDBOX_MAX_INSTANCE": "<SANDBOX_MAX_INSTANCE>",
    // 推定費用の単価（docs/deploy.md の 11）。Sandbox は rovo.config.json の sandbox.instance（agent の SANDBOX_INSTANCE と同じ）から
    // 計算した 1 時間あたりの上限側の値。vars.gateway.SANDBOX_USD_PER_HOUR を書けばそれを優先する。
    "SANDBOX_USD_PER_HOUR": "<SANDBOX_USD_PER_HOUR>",
    "WEB_USD_PER_1K_SEARCH": "0.25",
    "WEB_USD_PER_1K_FETCH": "0",
    "WEB_USD_PER_1K_BROWSE": "0.75"
  }
}
